<dryIoc:PrismApplication
    x:Class="Lan.Shapes.SimpleApp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dryIoc="http://prismlibrary.com/"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:Lan.Shapes.SimpleApp"
    xmlns:prism="clr-namespace:Prism;assembly=Prism.Wpf">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <hc:ThemeResources />
                <hc:Theme />
                <ResourceDictionary Source="pack://application:,,,/Lan.ImageViewer;component/Style.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Lan.ImageViewer;component/Geometries.xaml" />

            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</dryIoc:PrismApplication>
