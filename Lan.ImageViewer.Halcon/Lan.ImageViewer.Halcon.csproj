<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <!-- visiondotnet ships native helper DLLs under lib; MSBuild probes those
         files as managed references and reports MSB3246 even though they are
         required at runtime by Halcon. -->
    <NoWarn>$(NoWarn);MSB3246</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="9.0.9" />
    <PackageReference Include="visiondotnet" Version="1.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Lan.ImageViewer\Lan.ImageViewer.csproj" />
	<ProjectReference Include="..\src\Lan.Shapes\Lan.Shapes.csproj" />
    <ProjectReference Include="..\src\Lan.SketchBoard\Lan.SketchBoard.csproj" />
  </ItemGroup>

</Project>
