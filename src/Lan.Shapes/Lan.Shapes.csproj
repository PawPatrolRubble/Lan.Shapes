<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0-windows</TargetFramework>
	    <PackageVersion>1.1.24</PackageVersion>
	    <Description>WPF DrawingVisual shape core: geometry types, layers, stylers, handles, and metadata contracts for Lan.Shapes sketching.</Description>
	    <Authors>Lan</Authors>
	    <PackageTags>wpf;drawingvisual;shapes;annotation;sketch</PackageTags>
        <UseWPF>true</UseWPF>
    </PropertyGroup>

	<Target Name="PrePackage" BeforeTargets="BuildPackage">
		<PropertyGroup>
			<BuildCommand>$(BuildCommand) -IncludeReferencedProjects</BuildCommand>
		</PropertyGroup>
	</Target>
    <ItemGroup>
      <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    </ItemGroup>
</Project>
