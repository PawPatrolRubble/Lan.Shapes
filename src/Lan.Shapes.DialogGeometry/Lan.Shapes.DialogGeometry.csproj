<?xml version="1.0" encoding="UTF-8" ?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net8.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <Description>Dialog-driven geometries for Lan.Shapes: gridded rectangle, DXF import geometry, and related UI dialogs.</Description>
        <Authors>Lan</Authors>
        <PackageTags>wpf;shapes;dxf;dialog;grid</PackageTags>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <!--
          Intentional: HandyControls/netDxf are PrivateAssets so consumers of the
          fat Prism/ImageViewer packages do not get transitive package deps.
          CopyProjectReferencesToPackage embeds those DLLs into this package output.
        -->
        <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);CopyProjectReferencesToPackage</TargetsForTfmSpecificBuildOutput>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="HandyControls"
                          Version="3.4.5">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="netDxf"
                          Version="2023.11.10">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Lan.Shapes\Lan.Shapes.csproj" />
    </ItemGroup>
    <Target Name="CopyProjectReferencesToPackage"
            DependsOnTargets="ResolveReferences">
        <ItemGroup>
            <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)"
                                  Condition="'%(Extension)' == '.dll' AND ('%(Filename)' == 'netDxf' OR '%(Filename)' == 'HandyControl')" />
        </ItemGroup>
    </Target>
</Project>
