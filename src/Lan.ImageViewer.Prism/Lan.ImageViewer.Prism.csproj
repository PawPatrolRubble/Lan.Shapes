<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<PackageVersion>1.6.3</PackageVersion>
		<Description>Prism composition root for Lan.Shapes image viewer: DI module, default ViewModel, geometry type registration, and layer manager.</Description>
		<Authors>Lan</Authors>
		<PackageTags>wpf;prism;image-viewer;di;sketch</PackageTags>
		<ReferenceOutputAssembly>true</ReferenceOutputAssembly>
		<IncludeReferencedProjects>true</IncludeReferencedProjects>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<appendframeworktooutputpath>false</appendframeworktooutputpath>
	</PropertyGroup>

	<!--
	  Fat-package packaging (intentional):
	  Project references use PrivateAssets=All so this nupkg embeds Lan.ImageViewer,
	  Lan.Shapes, Custom, DialogGeometry, and SketchBoard outputs via
	  CopyProjectReferencesToPackage. Consumers take one package for the full
	  Prism host stack. Do not remove without multi-package dependency publishing.
	-->
	<PropertyGroup>
		<TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);CopyProjectReferencesToPackage</TargetsForTfmSpecificBuildOutput>
	</PropertyGroup>

	<Target Name="CopyProjectReferencesToPackage" DependsOnTargets="ResolveReferences">
		<ItemGroup>
			<BuildOutputInPackage Include="@(ReferenceCopyLocalPaths-&gt;WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
		<PackageReference Include="Prism.Wpf" Version="8.1.97" />
		<PackageReference Include="HandyControls" Version="3.4.5" />
		<PackageReference Include="netDxf" Version="2023.11.10" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Lan.ImageViewer\Lan.ImageViewer.csproj" PrivateAssets="All" />
		<ProjectReference Include="..\Lan.Shapes\Lan.Shapes.csproj" PrivateAssets="All" />
		<ProjectReference Include="..\Lan.Shapes.Custom\Lan.Shapes.Custom.csproj" PrivateAssets="All" />
		<ProjectReference Include="..\Lan.Shapes.DialogGeometry\Lan.Shapes.DialogGeometry.csproj" PrivateAssets="All" />
		<ProjectReference Include="..\Lan.SketchBoard\Lan.SketchBoard.csproj" PrivateAssets="All" />
	</ItemGroup>
</Project>
