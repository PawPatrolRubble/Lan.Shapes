<Window x:Class="Lan.ImageViewer.LayerEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="编辑图层" Width="390" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource DarkPanel.Background}"
        Foreground="{DynamicResource DarkPanel.ValueForeground}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Lan.ImageViewer;component/DarkControlsTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource DarkPanel.ValueForeground}" />
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource DarkPropertyTextBoxStyle}" />
            <Style TargetType="ComboBox" BasedOn="{StaticResource DarkComboBoxStyle}" />
            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboBoxItemStyle}" />
            <Style TargetType="Button" BasedOn="{StaticResource DarkButtonStyle}" />
            <Style TargetType="xctk:ColorPicker" BasedOn="{StaticResource DarkColorPickerStyle}" />
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="95" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="名称" VerticalAlignment="Center" />
        <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" />
        <TextBlock Grid.Row="1" Text="说明" VerticalAlignment="Center" />
        <TextBox x:Name="DescriptionBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />
        <TextBlock Grid.Row="2" Text="样式状态" VerticalAlignment="Center" />
        <ComboBox x:Name="StyleStateBox" Grid.Row="2" Grid.Column="1" Margin="0,4,0,10"
                  SelectionChanged="StyleState_SelectionChanged" ToolTip="分别编辑各状态的图层样式">
            <ComboBoxItem Content="普通" Tag="Normal" />
            <ComboBoxItem Content="鼠标悬停 (Hover)" Tag="MouseOver" />
            <ComboBoxItem Content="选中" Tag="Selected" />
            <ComboBoxItem Content="锁定" Tag="Locked" />
        </ComboBox>
        <TextBlock Grid.Row="3" Text="线条颜色" VerticalAlignment="Center" />
        <xctk:ColorPicker x:Name="StrokeColorPicker" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" />
        <TextBlock Grid.Row="4" Text="填充颜色" VerticalAlignment="Center" />
        <xctk:ColorPicker x:Name="FillColorPicker" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" />
        <TextBlock Grid.Row="5" Text="线型" VerticalAlignment="Center" />
        <ComboBox x:Name="DashStyleBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8">
            <ComboBoxItem Content="Solid" />
            <ComboBoxItem Content="Dash" />
            <ComboBoxItem Content="Dot" />
            <ComboBoxItem Content="DashDot" />
            <ComboBoxItem Content="DashDotDot" />
        </ComboBox>
        <TextBlock Grid.Row="6" Text="线宽" VerticalAlignment="Center" />
        <TextBox x:Name="StrokeThicknessBox" Grid.Row="6" Grid.Column="1" Margin="0,0,0,8" />
        <TextBlock Grid.Row="7" Text="填充不透明度" VerticalAlignment="Center" />
        <TextBox x:Name="FillOpacityBox" Grid.Row="7" Grid.Column="1" Margin="0,0,0,8" ToolTip="0 完全透明，1 完全不透明" />
        <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" Width="75" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="应用" Width="75" IsDefault="True" Click="Apply_Click" />
        </StackPanel>
    </Grid>
</Window>
