<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:custom="clr-namespace:Lan.Shapes.Custom;assembly=Lan.Shapes.Custom"
    xmlns:lanShapes="clr-namespace:Lan.Shapes;assembly=Lan.Shapes"
    xmlns:shapes="clr-namespace:Lan.Shapes.Shapes;assembly=Lan.Shapes">

    <!--  Dark Theme Brushes for Properties Panel  -->
    <SolidColorBrush x:Key="DarkPanel.Background" Color="#222225" />
    <SolidColorBrush x:Key="DarkPanel.CardBackground" Color="#1E1E20" />
    <SolidColorBrush x:Key="DarkPanel.Border" Color="#38383E" />
    <SolidColorBrush x:Key="DarkPanel.HeaderForeground" Color="#EAEAEA" />
    <SolidColorBrush x:Key="DarkPanel.LabelForeground" Color="#9D9DA6" />
    <SolidColorBrush x:Key="DarkPanel.ValueForeground" Color="#F2F2F2" />
    <SolidColorBrush x:Key="DarkPanel.InputBackground" Color="#2A2A2E" />
    <SolidColorBrush x:Key="DarkPanel.InputBorder" Color="#42424A" />
    <SolidColorBrush x:Key="DarkPanel.InputFocusBorder" Color="#007ACC" />
    <SolidColorBrush x:Key="DarkPanel.ReadOnlyInputBackground" Color="#242427" />
    <SolidColorBrush x:Key="DarkPanel.Accent" Color="#389BFF" />
    <SolidColorBrush x:Key="DarkPanel.ItemHover" Color="#2E2E34" />
    <SolidColorBrush x:Key="DarkPanel.ItemSelected" Color="#0E639C" />

    <!--  Dark Card Border Style  -->
    <Style x:Key="DarkPropertyCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DarkPanel.CardBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkPanel.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8" />
    </Style>

    <!--  Dark Property Label Style  -->
    <Style x:Key="DarkPropertyLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource DarkPanel.LabelForeground}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,1" />
    </Style>

    <!--  Dark Property TextBox Style  -->
    <Style x:Key="DarkPropertyTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource DarkPanel.InputBackground}" />
        <Setter Property="Foreground" Value="{StaticResource DarkPanel.ValueForeground}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkPanel.InputBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border
                        x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="3"
                        SnapsToDevicePixels="True">
                        <ScrollViewer
                            x:Name="PART_ContentHost"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource DarkPanel.InputFocusBorder}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#555560" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Dark Property ReadOnly TextBox Style  -->
    <Style
        x:Key="DarkPropertyReadOnlyTextBoxStyle"
        BasedOn="{StaticResource DarkPropertyTextBoxStyle}"
        TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource DarkPanel.ReadOnlyInputBackground}" />
        <Setter Property="Foreground" Value="#BBBBBB" />
        <Setter Property="BorderBrush" Value="#33333A" />
        <Setter Property="IsReadOnly" Value="True" />
    </Style>

    <!--  Dark Property CheckBox Style  -->
    <Style x:Key="DarkPropertyCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource DarkPanel.ValueForeground}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  Dark ListBox Style  -->
    <Style x:Key="DarkListBoxStyle" TargetType="ListBox">
        <Setter Property="Background" Value="#1A1A1C" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkPanel.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource DarkPanel.ValueForeground}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="6,3" />
                    <Setter Property="Margin" Value="1,1" />
                    <Setter Property="Foreground" Value="{StaticResource DarkPanel.ValueForeground}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border
                                    x:Name="Bd"
                                    Padding="{TemplateBinding Padding}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="3"
                                    SnapsToDevicePixels="True">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource DarkPanel.ItemHover}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource DarkPanel.ItemSelected}" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Dark ToggleButton Style  -->
    <Style x:Key="DarkPanelToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="#2A2A2E" />
        <Setter Property="Foreground" Value="#CCCCCC" />
        <Setter Property="BorderBrush" Value="#38383E" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#1E1E20" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#007ACC" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#555560" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Dark Icon ToggleButton Style (for toolbar icon buttons)  -->
    <Style x:Key="DarkIconButtonToggleStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="#252528" />
        <Setter Property="Foreground" Value="#CCCCCC" />
        <Setter Property="BorderBrush" Value="#38383E" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4"
                        SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#333338" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#555560" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#2A2A30" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#007ACC" />
                            <Setter Property="Foreground" Value="#389BFF" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="border" Property="Background" Value="#32323A" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#1F94F4" />
                            <Setter Property="Foreground" Value="#50B0FF" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  DataTemplates for each Geometry Type  -->

    <!--  1. Circle  -->
    <DataTemplate DataType="{x:Type shapes:Circle}">
        <Border Style="{StaticResource DarkPropertyCardStyle}">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="{StaticResource DarkPanel.Accent}"
                        Text="Circle" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="#888888"
                        Text="{Binding State}" />
                </DockPanel>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="65" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource DarkPropertyLabelStyle}" Text="Radius" />
                    <TextBox
                        Grid.Column="1"
                        Style="{StaticResource DarkPropertyTextBoxStyle}"
                        Text="{Binding Radius, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:F1}'}" />
                </Grid>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="65" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource DarkPropertyLabelStyle}" Text="Center" />
                    <TextBox
                        Grid.Column="1"
                        Margin="0,0,2,0"
                        Style="{StaticResource DarkPropertyReadOnlyTextBoxStyle}"
                        Text="{Binding Center.X, Mode=OneWay, StringFormat='X: {0:F1}'}" />
                    <TextBox
                        Grid.Column="2"
                        Margin="2,0,0,0"
                        Style="{StaticResource DarkPropertyReadOnlyTextBoxStyle}"
                        Text="{Binding Center.Y, Mode=OneWay, StringFormat='Y: {0:F1}'}" />
                </Grid>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="65" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource DarkPropertyLabelStyle}" Text="Tag" />
                    <TextBox
                        Grid.Column="1"
                        Style="{StaticResource DarkPropertyTextBoxStyle}"
                        Text="{Binding Tag, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                </Grid>

                <CheckBox
                    Margin="0,6,0,0"
                    Content="锁定 (Lock)"
                    IsChecked="{Binding IsLocked, Mode=TwoWay}"
                    Style="{StaticResource DarkPropertyCheckBoxStyle}" />
            </StackPanel>
        </Border>
    </DataTemplate>

