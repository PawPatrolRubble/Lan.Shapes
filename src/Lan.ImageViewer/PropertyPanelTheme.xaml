                    <TextBox Grid.Column="2" Margin="2,0,0,0" Text="{Binding Row, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:F1}'}" Style="{StaticResource DarkPropertyTextBoxStyle}" ToolTip="Center Y / Row" />
