                    <TextBlock Text="Rectangle" FontWeight="Bold" Foreground="{StaticResource DarkPanel.Accent}" FontSize="13" />
                    <TextBlock Text="{Binding State}" HorizontalAlignment="Right" Foreground="#888888" FontSize="11" VerticalAlignment="Center" />
                </DockPanel>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="65" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="TopLeft" Style="{StaticResource DarkPropertyLabelStyle}" />
                    <TextBox Grid.Column="1" Margin="0,0,2,0" Text="{Binding TopLeft.X, Mode=OneWay, StringFormat='X: {0:F1}'}" Style="{StaticResource DarkPropertyReadOnlyTextBoxStyle}" />
                    <TextBox Grid.Column="2" Margin="2,0,0,0" Text="{Binding TopLeft.Y, Mode=OneWay, StringFormat='Y: {0:F1}'}" Style="{StaticResource DarkPropertyReadOnlyTextBoxStyle}" />
                </Grid>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="65" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="BottomRight" Style="{StaticResource DarkPropertyLabelStyle}" />
                    <TextBox Grid.Column="1" Margin="0,0,2,0" Text="{Binding BottomRight.X, Mode=OneWay, StringFormat='X: {0:F1}'}" Style="{StaticResource DarkPropertyReadOnlyTextBoxStyle}" />
                    <TextBox Grid.Column="2" Margin="2,0,0,0" Text="{Binding BottomRight.Y, Mode=OneWay, StringFormat='Y: {0:F1}'}" Style="{StaticResource DarkPropertyReadOnlyTextBoxStyle}" />
                </Grid>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="65" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Size" Style="{StaticResource DarkPropertyLabelStyle}" />
                    <TextBlock Grid.Column="1" Text="W" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11" />
                    <TextBox Grid.Column="2" Margin="0,0,4,0" Text="{Binding Width, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:F1}'}" Style="{StaticResource DarkPropertyTextBoxStyle}" ToolTip="Width" />
                    <TextBlock Grid.Column="3" Text="H" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11" />
                    <TextBox Grid.Column="4" Text="{Binding Height, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:F1}'}" Style="{StaticResource DarkPropertyTextBoxStyle}" ToolTip="Height" />
                </Grid>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="65" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Tag" Style="{StaticResource DarkPropertyLabelStyle}" />
                    <TextBox Grid.Column="1" Text="{Binding Tag, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DarkPropertyTextBoxStyle}" />
                </Grid>

                <CheckBox Margin="0,6,0,0" IsChecked="{Binding IsLocked, Mode=TwoWay}" Content="锁定 (Lock)" Style="{StaticResource DarkPropertyCheckBoxStyle}" />
            </StackPanel>
        </Border>
    </DataTemplate>

