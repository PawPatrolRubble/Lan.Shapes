<Project Sdk="Microsoft.NET.Sdk">


	  <PropertyGroup>
		  <TargetFramework>net8.0-windows</TargetFramework>
		  <UseWPF>true</UseWPF>
		  <PackageVersion>1.1.11</PackageVersion>
		  <Description>WPF image viewer and sketch chrome for Lan.Shapes: zoom/pan control, geometry palette icons, and viewer host surface.</Description>
		  <Authors>Lan</Authors>
		  <PackageTags>wpf;image-viewer;sketch;annotation</PackageTags>
		  <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
		  <IncludeReferencedProjects>true</IncludeReferencedProjects>
		  <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	  </PropertyGroup>

	<PropertyGroup>
		<EnableSourceControlManagerQueries>true</EnableSourceControlManagerQueries>
	</PropertyGroup>
	
	
	<!--
	  Fat-package packaging (intentional):
	  Project references use PrivateAssets=All so restore does not emit separate
	  NuGet dependencies for Lan.Shapes / Lan.SketchBoard. CopyProjectReferencesToPackage
	  then embeds those project outputs into this package so a single nupkg can
	  ship the viewer stack. Do not remove without switching to multi-package
	  dependency publishing.
	-->
	<PropertyGroup>
		<TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);CopyProjectReferencesToPackage</TargetsForTfmSpecificBuildOutput>
	</PropertyGroup>


	<Target Name="CopyProjectReferencesToPackage" DependsOnTargets="ResolveReferences">
		<ItemGroup>
			<BuildOutputInPackage Include="@(ReferenceCopyLocalPaths-&gt;WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))" />
		</ItemGroup>
	</Target>

	<ItemGroup>
	  <None Remove="Icons\ellipse.png" />
	  <None Remove="Icons\polygon.png" />
	  <None Remove="Icons\square.png" />
	  <None Remove="Icons\ZoomIn.png" />
	  <None Remove="Icons\ZoomOut.png" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Lan.Shapes\Lan.Shapes.csproj" PrivateAssets="All" />
	  <ProjectReference Include="..\Lan.SketchBoard\Lan.SketchBoard.csproj" PrivateAssets="All" />
	</ItemGroup>

	<ItemGroup>
	  <Resource Include="Icons\ellipse.png">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </Resource>
	  <Resource Include="Icons\polygon.png">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </Resource>
	  <Resource Include="Icons\square.png">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </Resource>
	  <Resource Include="Icons\ZoomIn.png">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </Resource>
	  <Resource Include="Icons\ZoomOut.png">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </Resource>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="ViewModels\" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Extended.Wpf.Toolkit" Version="4.5.1" />
	</ItemGroup>

</Project>
