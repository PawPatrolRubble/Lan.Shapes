    <Style x:Key="LayerPanelButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource LayerPanel.Text}" />
        <Setter Property="Background" Value="{StaticResource LayerPanel.Button}" />
        <Setter Property="BorderBrush" Value="{StaticResource LayerPanel.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontFamily" Value="{StaticResource LayerPanel.TextFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="ButtonBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource LayerPanel.Border}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource LayerPanel.Subtle}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource LayerPanel.Background}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource LayerPanel.Cyan}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style
        x:Key="LayerPanelIconButtonStyle"
        BasedOn="{StaticResource LayerPanelButtonStyle}"
        TargetType="Button">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Path
                            Width="12"
                            Height="12"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                            Stretch="Uniform">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="新增">
                                            <Setter Property="Fill" Value="{StaticResource LayerPanel.Green}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding}" Value="保存">
                                            <Setter Property="Fill" Value="{StaticResource LayerPanel.Cyan}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding}" Value="另存为">
                                            <Setter Property="Fill" Value="{StaticResource LayerPanel.Amber}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="{Binding}" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CadPropertyCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource LayerPanel.Section}" />
        <Setter Property="BorderBrush" Value="{StaticResource LayerPanel.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="TextElement.FontFamily" Value="{StaticResource LayerPanel.TextFont}" />
    </Style>
    <Style x:Key="CadPropertyHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource LayerPanel.MonoFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource LayerPanel.Amber}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="CadPropertyLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource LayerPanel.Muted}" />
        <Setter Property="FontFamily" Value="{StaticResource LayerPanel.TextFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,1" />
    </Style>
    <Style x:Key="CadPropertyTextBoxStyle" TargetType="TextBox">
        <Setter Property="local:TextBoxFocusBehavior.SelectAllOnFocus" Value="True" />
        <Setter Property="Background" Value="{StaticResource LayerPanel.Background}" />
        <Setter Property="Foreground" Value="{StaticResource LayerPanel.Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource LayerPanel.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="7,4" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontFamily" Value="{StaticResource LayerPanel.MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{StaticResource LayerPanel.Text}" />
        <Setter Property="SelectionBrush" Value="{StaticResource LayerPanel.Cyan}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border
                        x:Name="InputBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4"
                        SnapsToDevicePixels="True">
                        <ScrollViewer
                            x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource LayerPanel.Subtle}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource LayerPanel.Cyan}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style
        x:Key="CadPropertyReadOnlyTextBoxStyle"
        BasedOn="{StaticResource CadPropertyTextBoxStyle}"
        TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="Background" Value="{StaticResource LayerPanel.Button}" />
        <Setter Property="Foreground" Value="{StaticResource LayerPanel.Muted}" />
    </Style>
    <Style x:Key="CadPropertyCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource LayerPanel.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource LayerPanel.TextFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            x:Name="CheckBorder"
                            Width="14"
                            Height="14"
                            Margin="0,0,7,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource LayerPanel.Background}"
                            BorderBrush="{StaticResource LayerPanel.Subtle}"
                            BorderThickness="1"
                            CornerRadius="3">
                            <Path
                                x:Name="CheckMark"
                                Margin="2"
                                Data="M0,4 L3,7 L8,0"
                                Stretch="Uniform"
                                Stroke="{StaticResource LayerPanel.Green}"
                                StrokeEndLineCap="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="1.5"
                                Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter
                            Grid.Column="1"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource LayerPanel.Green}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource LayerPanel.Cyan}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource LayerPanel.Cyan}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style
        x:Key="LayerPanelRowButtonStyle"
        BasedOn="{StaticResource LayerPanelButtonStyle}"
        TargetType="Button">
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="FontSize" Value="11" />
    </Style>
    <Style
        x:Key="LayerPanelSelectButtonStyle"
        BasedOn="{StaticResource LayerPanelRowButtonStyle}"
        TargetType="Button">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Background" Value="{StaticResource LayerPanel.ActiveButton}" />
                <Setter Property="BorderBrush" Value="{StaticResource LayerPanel.ActiveButton}" />
                <Setter Property="Foreground" Value="White" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LayerPanelVisibilityStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Foreground" Value="{StaticResource LayerPanel.Muted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTip" Value="显示图层" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        x:Name="VisibilityButtonBorder"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        CornerRadius="3">
                        <Path
                            x:Name="VisibilityIcon"
                            Width="15"
                            Height="15"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="{StaticResource SolidHide}"
                            Fill="{TemplateBinding Foreground}"
                            Stretch="Uniform" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="VisibilityIcon" Property="Data" Value="{StaticResource SolidShow}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="VisibilityButtonBorder" Property="Background" Value="{StaticResource LayerPanel.Border}" />
                            <Setter Property="Foreground" Value="{StaticResource LayerPanel.Cyan}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="VisibilityButtonBorder" Property="BorderBrush" Value="{StaticResource LayerPanel.Cyan}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="ToolTip" Value="隐藏图层" />
            </Trigger>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource LayerPanel.Amber}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LayerPanelShapeMarkerStyle" TargetType="ToggleButton">
        <Setter Property="ToolTip" Value="加入或移出选择" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        x:Name="FocusRing"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        CornerRadius="3">
                        <Path
                            Width="12"
                            Height="12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="{Binding GeometryType, Converter={StaticResource ShapeTreeIconConverter}}"
                            Fill="{StaticResource LayerPanel.Amber}"
                            Stretch="Uniform" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="FocusRing" Property="Background" Value="{StaticResource LayerPanel.Border}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{StaticResource LayerPanel.Cyan}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                <Setter Property="IsEnabled" Value="False" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsGeometryRendered}" Value="False">
                <Setter Property="IsEnabled" Value="False" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="LayerPanelExpanderStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="24" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <Border
                            Width="10"
                            Height="10"
                            Background="{StaticResource LayerPanel.Amber}"
                            CornerRadius="1">
                            <Grid>
                                <Border
                                    Width="6"
                                    Height="1"
                                    Background="{StaticResource LayerPanel.Background}" />
                                <Border
                                    x:Name="PlusStroke"
                                    Width="1"
                                    Height="6"
                                    Background="{StaticResource LayerPanel.Background}" />
                            </Grid>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PlusStroke" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="LayerPanelTreeItemStyle" TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{StaticResource LayerPanel.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Margin" Value="0,1,0,1" />
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <!--  Unique sibling indices let connector bindings follow insertion and removal.  -->
        <Setter Property="AlternationCount" Value="2147483647" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <Border
                        x:Name="LayerFrame"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid
                                x:Name="SiblingGuide"
                                Margin="-8,-1,0,-1"
                                IsHitTestVisible="False">
                                <Grid.Visibility>
                                    <MultiBinding Converter="{StaticResource TreeBranchVisibilityConverter}">
                                        <Binding Path="TemplatedParent" RelativeSource="{RelativeSource AncestorType=ItemsPresenter}" />
                                    </MultiBinding>
                                </Grid.Visibility>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border
                                    Width="1"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource LayerPanel.Border}" />
                                <Border
                                    x:Name="BranchTail"
                                    Grid.Row="1"
                                    Width="1"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource LayerPanel.Border}">
                                    <Border.Visibility>
                                        <MultiBinding Converter="{StaticResource TreeBranchVisibilityConverter}" ConverterParameter="Tail">
                                            <Binding Path="TemplatedParent" RelativeSource="{RelativeSource AncestorType=ItemsPresenter}" />
                                            <Binding Path="(ItemsControl.AlternationIndex)" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="TemplatedParent.Items.Count" RelativeSource="{RelativeSource AncestorType=ItemsPresenter}" />
                                        </MultiBinding>
                                    </Border.Visibility>
                                </Border>
                                <Border
                                    Width="16"
                                    Height="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Background="{StaticResource LayerPanel.Border}" />
                            </Grid>
                            <Border
                                Grid.Row="1"
                                Width="1"
                                Margin="-8,0,0,-1"
                                HorizontalAlignment="Left"
                                Background="{StaticResource LayerPanel.Border}"
                                IsHitTestVisible="False">
                                <Border.Visibility>
                                    <MultiBinding Converter="{StaticResource TreeBranchVisibilityConverter}" ConverterParameter="Tail">
                                        <Binding Path="TemplatedParent" RelativeSource="{RelativeSource AncestorType=ItemsPresenter}" />
                                        <Binding Path="(ItemsControl.AlternationIndex)" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="TemplatedParent.Items.Count" RelativeSource="{RelativeSource AncestorType=ItemsPresenter}" />
                                    </MultiBinding>
                                </Border.Visibility>
                            </Border>
                            <Grid x:Name="ChildStem" IsHitTestVisible="False">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border
                                    Grid.Row="1"
                                    Width="1"
                                    Background="{StaticResource LayerPanel.Border}" />
                            </Grid>
                            <Border
                                x:Name="ChildLead"
                                Grid.Row="1"
                                Width="1"
                                Height="4"
                                VerticalAlignment="Top"
                                Background="{StaticResource LayerPanel.Border}"
                                IsHitTestVisible="False" />
                            <ToggleButton
                                x:Name="Expander"
                                IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                Style="{StaticResource LayerPanelExpanderStyle}" />
                            <Border
                                x:Name="Header"
                                Grid.Column="1"
                                MinHeight="28"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                                <ContentPresenter
                                    x:Name="PART_Header"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    ContentSource="Header"
                                    TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <ItemsPresenter
                                x:Name="ItemsHost"
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,4,0,0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="LayerFrame" Property="BorderBrush" Value="{StaticResource LayerPanel.ActiveBorder}" />
                            <Setter TargetName="LayerFrame" Property="BorderThickness" Value="1" />
                            <Setter TargetName="LayerFrame" Property="Background" Value="{StaticResource LayerPanel.Section}" />
                            <Setter TargetName="Header" Property="Background" Value="{StaticResource LayerPanel.Button}" />
                        </DataTrigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ChildStem" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ChildLead" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ChildStem" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ChildLead" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger SourceName="Header" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Header" Property="Background" Value="{StaticResource LayerPanel.Button}" />
                        </Trigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Header" Property="BorderBrush" Value="{StaticResource LayerPanel.Cyan}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style
        x:Key="LayerPanelLayerItemStyle"
        BasedOn="{StaticResource LayerPanelTreeItemStyle}"
        TargetType="TreeViewItem">
        <Setter Property="Padding" Value="2,7" />
        <Setter Property="Tag" Value="{Binding IsActive}" />
    </Style>
    <Style
        x:Key="LayerPanelShapeItemStyle"
        BasedOn="{StaticResource LayerPanelTreeItemStyle}"
        TargetType="TreeViewItem">
        <Setter Property="Padding" Value="4,2" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{StaticResource LayerPanel.Selection}" />
                <Setter Property="BorderBrush" Value="{StaticResource LayerPanel.ActiveBorder}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
