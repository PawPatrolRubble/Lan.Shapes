<UserControl
    x:Class="Lan.ImageViewer.ImageViewerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Lan.ImageViewer"
    xmlns:shapeEnums="clr-namespace:Lan.Shapes.Enums;assembly=Lan.Shapes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shapes="clr-namespace:Lan.Shapes.Shapes;assembly=Lan.Shapes"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    x:Name="Root"
    d:DataContext="{d:DesignInstance local:IImageViewerViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="White"
    mc:Ignorable="d">


    <UserControl.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Lan.ImageViewer;component/Style.xaml" />
                <ResourceDictionary Source="/Lan.ImageViewer;component/Geometries.xaml" />


            </ResourceDictionary.MergedDictionaries>

            <!--<xamlFlair:Offset x:Key="PositiveOffset" OffsetValue="20" />
            <xamlFlair:Offset x:Key="NegativeOffset" OffsetValue="-50" />

            <system:Double x:Key="SmallScaleFactor">0.75</system:Double>

            <xamlFlair:AnimationSettings
                x:Key="SlideFromTop"
                Kind="TranslateYFrom"
                OffsetY="{StaticResource NegativeOffset}" />-->

            <!--  Scale to a smaller value  -->

            <SolidColorBrush x:Key="Expander.Static.Arrow.Stroke" Color="White" />
            <SolidColorBrush x:Key="Expander.MouseOver.Arrow.Stroke" Color="Lime" />
            <SolidColorBrush x:Key="Expander.Pressed.Arrow.Stroke" Color="Lime" />
            <SolidColorBrush x:Key="Expander.Disabled.Arrow.Stroke" Color="#FF707070" />

            <DataTemplate x:Key="DarkComboBoxTextTemplate">
                <TextBlock Text="{Binding}" Foreground="{StaticResource DarkPanel.ValueForeground}" />
            </DataTemplate>
            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboBoxItemStyle}">
                <Setter Property="ContentTemplate" Value="{StaticResource DarkComboBoxTextTemplate}" />
            </Style>
            <Style x:Key="ShapeSelectionCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource DarkPropertyCheckBoxStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLocked}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                    <DataTrigger Binding="{Binding IsGeometryRendered}" Value="False"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                </Style.Triggers>
            </Style>


        </ResourceDictionary>

    </UserControl.Resources>


    <Grid>


        <local:ImageViewer
            x:Name="ImageViewer"
            BorderBrush="LightGray"
            BorderThickness="0"
            CrossLineColor="Lime"
            DefaultStrokeThickness="1"
            ImageSource="{Binding Image, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
            LineDirectionMode="{Binding LineDirectionMode, ElementName=Root}"
            MouseDoubleClickPosition="{Binding MouseDoubleClickPosition, UpdateSourceTrigger=PropertyChanged, Mode=OneWayToSource}"
            Scale="{Binding Scale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            ShowCrossLine="{Binding ShowCrossLine, ElementName=Root}"
            ShowGeometries="{Binding ShowGeometries, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=True, TargetNullValue=True}"
            SketchBoardDataManager="{Binding SketchBoardDataManager}"
            StrokeThickness="1"
            Style="{StaticResource ImageViewer.Compact}" />



        <!-- Top-Right Floating Controls (Toolbar + Property Panel) -->
        <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Floating Top Toolbar -->
            <Border
                Grid.Row="0"
                HorizontalAlignment="Right"
                Background="#E61E1E22"
                BorderBrush="{StaticResource DarkPanel.Border}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="4,2"
                SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Opacity="0.35" ShadowDepth="2" Direction="270" Color="Black" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="选择" Style="{StaticResource DarkButtonStyle}" Margin="2,0,4,0"
                            Command="{Binding SelectionModeCommand}" ToolTip="选择图形；Ctrl 多选，空白处拖动框选，中键平移" />
                    <!-- Geometry Drawing Tools -->
                    <ItemsControl
                        x:Name="Tools"
                        VerticalAlignment="Center"
                        FontSize="15"
                        ItemTemplate="{StaticResource GeometryTypeTemplate}"
                        ItemsSource="{Binding GeometryTypeList}"
                        Visibility="{Binding ShowShapeTypes, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="6,0,4,0">
                        <TextBlock Text="图层" Margin="0,0,5,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource DarkPanel.LabelForeground}" />
                        <ComboBox x:Name="CurrentLayerSelector" Width="140"
                                  Style="{StaticResource DarkComboBoxStyle}"
                                  ItemsSource="{Binding Layers}"
                                  SelectedItem="{Binding SelectedShapeLayer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  AutomationProperties.Name="当前图层" ToolTip="新绘制的图形将使用此图层">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource DarkPanel.ValueForeground}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel
                        Orientation="Horizontal"
                        Margin="6,0,2,0"
                        Visibility="{Binding ShowShapeTypes, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            Text="Line:"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource DarkPanel.LabelForeground}" />
                        <ComboBox
                            x:Name="LineDirectionSelector"
                            Style="{StaticResource DarkComboBoxStyle}"
                            Width="108"
                            VerticalAlignment="Center"
                            SelectedValuePath="Tag"
                            SelectedValue="{Binding LineDirectionMode, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="Line direction"
                            ToolTip="Line direction. In Free mode, hold Shift while drawing or resizing to choose horizontal or vertical.">
                            <ComboBoxItem Content="Free" Tag="{x:Static shapeEnums:LineDirectionMode.Free}" />
                            <ComboBoxItem Content="Horizontal" Tag="{x:Static shapeEnums:LineDirectionMode.Horizontal}" />
                            <ComboBoxItem Content="Vertical" Tag="{x:Static shapeEnums:LineDirectionMode.Vertical}" />
                        </ComboBox>
                    </StackPanel>

                    <!-- Divider between tools and action buttons -->
                    <Rectangle
                        Width="1"
                        Height="20"
                        Margin="4,0"
                        Fill="{StaticResource DarkPanel.Border}"
                        Visibility="{Binding ShowShapeTypes, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <!-- Eye Icon ToggleButton (Show / Hide all geometries) -->
                    <ToggleButton
                        x:Name="BtnToggleGeometries"
                        Style="{StaticResource DarkIconButtonToggleStyle}"
                        Margin="2,0"
                        IsChecked="{Binding ShowGeometries, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=True, TargetNullValue=True}"
                        Click="BtnToggleGeometries_Click"
                        ToolTip="显示/隐藏图形">
                        <Path
                            x:Name="EyeIconPath"
                            Width="16"
                            Height="16"
                            Stretch="Uniform"
                            Fill="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Foreground}">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="{StaticResource EyeOff}" />
                                    <Setter Property="Opacity" Value="0.6" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=IsChecked}" Value="True">
                                            <Setter Property="Data" Value="{StaticResource Eye}" />
                                            <Setter Property="Opacity" Value="1.0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </ToggleButton>

                    <!-- Gear Icon ToggleButton (Show / Hide Properties Panel) -->
                    <ToggleButton
                        x:Name="BtnToggleProperties"
                        Style="{StaticResource DarkIconButtonToggleStyle}"
                        Margin="2,0"
                        IsChecked="{Binding ShowSimpleCanvas, Mode=TwoWay, Converter={StaticResource BooleanInverseConverter}}"
                        ToolTip="显示/隐藏属性面板">
                        <Path
                            Width="16"
                            Height="16"
                            Stretch="Uniform"
                            Data="{StaticResource Gear}"
                            Fill="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Foreground}" />
                    </ToggleButton>
                </StackPanel>
            </Border>

            <!-- Floating Property Panel (Positioned under the toolbar) -->
            <Border
                x:Name="LayerPanel"
                Grid.Row="1"
                Margin="0,6,0,0"
                HorizontalAlignment="Right"
                Width="260"
                MaxHeight="{Binding ActualHeight, ElementName=Root, Converter={StaticResource AvailablePanelHeightConverter}}"
                Background="{StaticResource DarkPanel.Background}"
                BorderBrush="{StaticResource DarkPanel.Border}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="8"
                SnapsToDevicePixels="True"
                Visibility="{Binding ShowSimpleCanvas, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" Opacity="0.45" ShadowDepth="3" Direction="270" Color="Black" />
                </Border.Effect>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="2,2,2,6">
                    <DockPanel>
                        <TextBlock
                            Text="图层与图形"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource DarkPanel.HeaderForeground}"
                            VerticalAlignment="Center" />
                        <Border
                            HorizontalAlignment="Right"
                            Background="#333338"
                            CornerRadius="8"
                            Padding="6,1"
                            VerticalAlignment="Center">
                            <TextBlock
                                Text="{Binding Shapes.Count, StringFormat='{}{0}'}"
                                FontSize="11"
                                Foreground="#AAAAAA" />
                        </Border>
                    </DockPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="新增" Style="{StaticResource DarkButtonStyle}" Click="NewLayer_Click" Margin="0,0,5,0" />
                            <Button Content="保存" Style="{StaticResource DarkButtonStyle}" Click="SaveLayers_Click" Margin="0,0,5,0" />
                            <Button Content="另存为" Style="{StaticResource DarkButtonStyle}" Click="SaveLayersAs_Click" />
                        </WrapPanel>
                        <TextBlock Text="{Binding LayerConfigurationStatus}" ToolTip="{Binding LayerConfigurationPath}"
                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource DarkPanel.LabelForeground}"
                                   FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>

                    <TreeView
                        x:Name="LayerTree"
                        Grid.Row="1"
                        MinHeight="100"
                        MaxHeight="220"
                        Margin="0,0,0,6"
                        Background="#1A1A1C"
                        Foreground="#EEEEEE"
                        BorderBrush="#333338"
                        ItemsSource="{Binding LayerGroups}"
                        PreviewMouseLeftButtonDown="LayerTree_PreviewMouseLeftButtonDown"
                        SelectedItemChanged="LayerTree_SelectedItemChanged"
                        PreviewKeyDown="LayerTree_PreviewKeyDown">
                        <TreeView.Resources>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource DarkTreeViewItemStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource DarkPanel.ItemSelected}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.Resources>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Shapes}">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                              Style="{StaticResource DarkPropertyCheckBoxStyle}"
                                              ToolTip="显示或隐藏此图层的所有图形"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" Margin="5,0" VerticalAlignment="Center"
                                               MaxWidth="95" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                                               Foreground="{StaticResource DarkPanel.ValueForeground}" />
                                    <Button Content="编辑" Padding="4,0" Margin="4,0,0,0"
                                            Style="{StaticResource DarkButtonStyle}"
                                            Click="EditLayer_Click" ToolTip="编辑图层样式" />
                                    <Button Content="选择" Padding="4,0" Margin="4,0,0,0"
                                            Style="{StaticResource DarkButtonStyle}"
                                            Click="SelectLayerShapes_Click" ToolTip="选中此图层中可见、未锁定的图形" />
                                </StackPanel>
                                <HierarchicalDataTemplate.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}" Tag="{Binding}"
                                                      Click="ShapeSelection_Click" Style="{StaticResource ShapeSelectionCheckBoxStyle}"
                                                      ToolTip="加入或移出选择" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding GeometryType}" Margin="4,2"
                                                       Foreground="{StaticResource DarkPanel.ValueForeground}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </HierarchicalDataTemplate.ItemTemplate>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <Separator Grid.Row="2" Background="{StaticResource DarkPanel.Border}" Margin="0,2,0,6" Height="1" />

                    <DockPanel Grid.Row="3">
                        <Border DockPanel.Dock="Top" Style="{StaticResource DarkPropertyCardStyle}" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedShapeCount, StringFormat='已选 {0} 个图形'}"
                                           Foreground="{StaticResource DarkPanel.HeaderForeground}" />
                                <TextBlock Text="{Binding SelectedLayerSummary}" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource DarkPanel.LabelForeground}" Margin="0,3,0,5" />
                                <TextBlock Text="所属图层" Foreground="{StaticResource DarkPanel.LabelForeground}" />
                                <ComboBox x:Name="AssignedLayerSelector" ItemsSource="{Binding Layers}"
                                          SelectedItem="{Binding TargetShapeLayer, Mode=TwoWay}"
                                          Style="{StaticResource DarkComboBoxStyle}" Margin="0,4,0,5"
                                          AutomationProperties.Name="所选图形所属图层">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Name}" Foreground="{StaticResource DarkPanel.ValueForeground}" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Content="应用到所选图形" Style="{StaticResource DarkButtonStyle}"
                                        IsEnabled="{Binding CanAssignSelectedLayer}" Click="AssignLayer_Click" />
                                <TextBlock Text="移入隐藏图层后，图形将在画布隐藏" FontSize="10" TextWrapping="Wrap"
                                           Foreground="{StaticResource DarkPanel.LabelForeground}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock
                            DockPanel.Dock="Top"
                            Text="属性"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource DarkPanel.HeaderForeground}"
                            Margin="2,0,2,6" />

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="320">
                            <ContentControl Content="{Binding PropertyShape}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Style.Triggers>
                                            <Trigger Property="Content" Value="{x:Null}">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate>
                                                            <Border Background="#1A1A1C" CornerRadius="4" Padding="12" BorderBrush="#2D2D32" BorderThickness="1">
                                                                <TextBlock
                                                                    Text="{Binding SelectionPrompt}"
                                                                    TextAlignment="Center"
                                                                    Foreground="#777780"
                                                                    FontSize="12"
                                                                    LineHeight="18"
                                                                    VerticalAlignment="Center" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </ScrollViewer>
                    </DockPanel>

                </Grid>
                </ScrollViewer>
            </Border>
        </Grid>



    </Grid>


</UserControl>
