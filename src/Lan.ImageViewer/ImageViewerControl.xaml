            <!--<xamlFlair:Offset x:Key="PositiveOffset" OffsetValue="20" />
            <xamlFlair:Offset x:Key="NegativeOffset" OffsetValue="-50" />

            <system:Double x:Key="SmallScaleFactor">0.75</system:Double>

            <xamlFlair:AnimationSettings
                x:Key="SlideFromTop"
                Kind="TranslateYFrom"
                OffsetY="{StaticResource NegativeOffset}" />-->

            <!--  Scale to a smaller value  -->

            <SolidColorBrush x:Key="Expander.Static.Arrow.Stroke" Color="White" />
            <SolidColorBrush x:Key="Expander.MouseOver.Arrow.Stroke" Color="Lime" />
            <SolidColorBrush x:Key="Expander.Pressed.Arrow.Stroke" Color="Lime" />
            <SolidColorBrush x:Key="Expander.Disabled.Arrow.Stroke" Color="#FF707070" />

            <DataTemplate x:Key="DarkComboBoxTextTemplate">
                <TextBlock Foreground="{StaticResource DarkPanel.ValueForeground}" Text="{Binding}" />
            </DataTemplate>
            <Style BasedOn="{StaticResource DarkComboBoxItemStyle}" TargetType="ComboBoxItem">
                <Setter Property="ContentTemplate" Value="{StaticResource DarkComboBoxTextTemplate}" />
            </Style>
            <Style x:Key="LayerVisibilityToggleStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource DarkPanel.LabelForeground}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="ToolTip" Value="显示图层" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border
                                x:Name="VisibilityButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Path
                                    x:Name="VisibilityIcon"
                                    Width="16"
                                    Height="16"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="{StaticResource SolidHide}"
                                    Fill="{TemplateBinding Foreground}"
                                    Stretch="Uniform" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="VisibilityIcon" Property="Data" Value="{StaticResource SolidShow}" />
                                    <Setter Property="Foreground" Value="{StaticResource DarkPanel.ValueForeground}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="VisibilityButtonBorder" Property="Background" Value="{StaticResource DarkPanel.ItemHover}" />
                                    <Setter Property="Foreground" Value="{StaticResource DarkPanel.Accent}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="VisibilityButtonBorder" Property="Background" Value="{StaticResource DarkPanel.ItemSelected}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="VisibilityButtonBorder" Property="BorderBrush" Value="{StaticResource DarkPanel.Accent}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.42" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="ToolTip" Value="隐藏图层" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ShapeSelectionMarkerStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="20" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Focusable" Value="True" />
                <Setter Property="ToolTip" Value="加入或移出选择" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border
                                x:Name="FocusRing"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Grid Margin="2">
                                    <Path
                                        x:Name="SelectionHandles"
                                        Data="M5,1 H1 V5 M11,1 H15 V5 M15,11 V15 H11 M5,15 H1 V11"
                                        Stretch="Fill"
                                        Stroke="#85858F"
                                        StrokeEndLineCap="Square"
                                        StrokeStartLineCap="Square"
                                        StrokeThickness="1.5" />
                                    <Ellipse
                                        x:Name="SelectedMark"
                                        Width="4"
                                        Height="4"
                                        Fill="{StaticResource DarkPanel.Accent}"
                                        Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="SelectionHandles" Property="Stroke" Value="{StaticResource DarkPanel.Accent}" />
                                    <Setter TargetName="SelectedMark" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="FocusRing" Property="Background" Value="#252529" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="FocusRing" Property="BorderBrush" Value="{StaticResource DarkPanel.Accent}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.42" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLocked}" Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsGeometryRendered}" Value="False">
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>


        </ResourceDictionary>

    </UserControl.Resources>


    <Grid ClipToBounds="True">


        <local:ImageViewer
            x:Name="ImageViewer"
            BorderBrush="LightGray"
            BorderThickness="0"
            CrossLineColor="Lime"
            DefaultStrokeThickness="1"
            ImageSource="{Binding Image, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
            LineDirectionMode="{Binding LineDirectionMode, ElementName=Root}"
            MouseDoubleClickPosition="{Binding MouseDoubleClickPosition, UpdateSourceTrigger=PropertyChanged, Mode=OneWayToSource}"
            Scale="{Binding Scale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            ShowCrossLine="{Binding ShowCrossLine, ElementName=Root}"
            ShowGeometries="{Binding ShowGeometries, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=True, TargetNullValue=True}"
            SketchBoardDataManager="{Binding SketchBoardDataManager}"
            StrokeThickness="1"
            Style="{StaticResource ImageViewer.Compact}" />



        <!--  Top-Right Floating Controls (Toolbar + Property Panel)  -->
        <Grid
            Margin="0,8,8,8"
            HorizontalAlignment="Right"
            VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Floating Top Toolbar  -->
            <Border
                Grid.Row="0"
                Padding="4,2"
                HorizontalAlignment="Right"
                Background="#E61E1E22"
                BorderBrush="{StaticResource DarkPanel.Border}"
                BorderThickness="1"
                CornerRadius="5"
                SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="8"
                        Direction="270"
                        Opacity="0.35"
                        ShadowDepth="2"
                        Color="Black" />
                </Border.Effect>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Button
                        Margin="2,0,4,0"
                        Command="{Binding SelectionModeCommand}"
                        Style="{StaticResource DarkButtonStyle}"
                        ToolTip="选择图形；Ctrl 多选，空白处拖动框选，中键平移">
                        <Path
                            Width="16"
                            Height="16"
                            Data="{StaticResource MousePointer}"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Stretch="Uniform" />
                    </Button>

                    <!--  Geometry Drawing Tools  -->
                    <ItemsControl
                        x:Name="Tools"
                        VerticalAlignment="Center"
                        FontSize="15"
                        ItemTemplate="{StaticResource GeometryTypeTemplate}"
                        ItemsSource="{Binding GeometryTypeList}"
                        Visibility="{Binding ShowShapeTypes, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <StackPanel Margin="6,0,4,0" Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource DarkPanel.LabelForeground}"
                            Text="图层" />
                        <ComboBox
                            x:Name="CurrentLayerSelector"
                            Width="140"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="当前图层"
                            ItemsSource="{Binding Layers}"
                            SelectedItem="{Binding SelectedShapeLayer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource DarkComboBoxStyle}"
                            ToolTip="新绘制的图形将使用此图层">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Foreground="{StaticResource DarkPanel.ValueForeground}"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel
                        Margin="6,0,2,0"
                        Orientation="Horizontal"
                        Visibility="{Binding ShowShapeTypes, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource DarkPanel.LabelForeground}"
                            Text="Line:" />
                        <ComboBox
                            x:Name="LineDirectionSelector"
                            Width="108"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Line direction"
                            SelectedValue="{Binding LineDirectionMode, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedValuePath="Tag"
                            Style="{StaticResource DarkComboBoxStyle}"
                            ToolTip="Line direction. In Free mode, hold Shift while drawing or resizing to choose horizontal or vertical.">
                            <ComboBoxItem Content="Free" Tag="{x:Static shapeEnums:LineDirectionMode.Free}" />
                            <ComboBoxItem Content="Horizontal" Tag="{x:Static shapeEnums:LineDirectionMode.Horizontal}" />
                            <ComboBoxItem Content="Vertical" Tag="{x:Static shapeEnums:LineDirectionMode.Vertical}" />
                        </ComboBox>


                    </StackPanel>

                    <!--  Divider between tools and action buttons  -->
                    <Rectangle
                        Width="1"
                        Height="20"
                        Margin="4,0"
                        Fill="{StaticResource DarkPanel.Border}"
                        Visibility="{Binding ShowShapeTypes, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <!--  Eye Icon ToggleButton (Show / Hide all geometries)  -->
                    <ToggleButton
                        x:Name="BtnToggleGeometries"
                        Margin="2,0"
                        Click="BtnToggleGeometries_Click"
                        IsChecked="{Binding ShowGeometries, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=True, TargetNullValue=True}"
                        Style="{StaticResource DarkIconButtonToggleStyle}"
                        ToolTip="显示/隐藏图形">
                        <Path
                            x:Name="EyeIconPath"
                            Width="16"
                            Height="16"
                            Fill="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Foreground}"
                            Stretch="Uniform">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="{StaticResource EyeOff}" />
                                    <Setter Property="Opacity" Value="0.6" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=IsChecked}" Value="True">
                                            <Setter Property="Data" Value="{StaticResource Eye}" />
                                            <Setter Property="Opacity" Value="1.0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </ToggleButton>
                    <!--  Crosshair Icon ToggleButton (Show / Hide the crosshair lines)  -->
                    <ToggleButton
                        x:Name="BtnToggleCrossLine"
                        Margin="2,0"
                        AutomationProperties.Name="显示/隐藏十字线"
                        IsChecked="{Binding ShowCrossLine, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource DarkIconButtonToggleStyle}"
                        ToolTip="显示/隐藏十字线">
                        <Path
                            Width="16"
                            Height="16"
                            Data="{StaticResource Crosshair2}"
                            Fill="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Foreground}"
                            Stretch="Uniform" />
                    </ToggleButton>

                    <!--  Open / Close Properties Panel  -->
                    <ToggleButton
                        x:Name="BtnToggleProperties"
                        Margin="2,0"
                        AutomationProperties.Name="显示/隐藏属性面板"
                        Checked="PropertyPanelToggle_Changed"
                        IsChecked="{Binding ShowSimpleCanvas, Mode=TwoWay, Converter={StaticResource BooleanInverseConverter}}"
                        Style="{StaticResource DarkIconButtonToggleStyle}"
                        ToolTip="显示/隐藏属性面板"
                        Unchecked="PropertyPanelToggle_Changed">
                        <Path
                            x:Name="PropertiesPanelIcon"
                            Width="16"
                            Height="16"
                            Fill="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Foreground}"
                            Stretch="Uniform">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="{StaticResource PanelRightOpen}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                            <Setter Property="Data" Value="{StaticResource PanelRightClose}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </ToggleButton>

                    <!--  Save canvas contents (image + geometries)  -->
                    <Button
                        x:Name="BtnSaveCanvas"
                        Width="32"
                        Height="32"
                        Margin="2,0"
                        Padding="0"
                        AutomationProperties.Name="保存画布内容"
                        Click="SaveCanvas_Click"
                        Style="{StaticResource DarkButtonStyle}"
                        ToolTip="保存画布内容（图像 + 图形）">
                        <Path
                            Width="16"
                            Height="16"
                            Data="{StaticResource Save}"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Border>

            <!--  Floating Property Panel (Positioned under the toolbar)  -->
            <Border
                x:Name="LayerPanel"
                Grid.Row="1"
                Width="360"
                MaxHeight="{Binding ActualHeight, ElementName=Root, Converter={StaticResource AvailablePanelHeightConverter}}"
                Margin="0,6,0,0"
                Padding="0"
                HorizontalAlignment="Right"
                Background="{StaticResource LayerPanel.Background}"
                BorderBrush="{StaticResource LayerPanel.Border}"
                BorderThickness="1"
                CornerRadius="5"
                SnapsToDevicePixels="True"
                Visibility="Collapsed">
                <Border.Resources>
                    <Style BasedOn="{StaticResource DarkScrollBarStyle}" TargetType="ScrollBar" />
                </Border.Resources>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="LayerPanelSlideTransform" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="12"
                        Direction="270"
                        Opacity="0.45"
                        ShadowDepth="3"
                        Color="Black" />
                </Border.Effect>

                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Grid MinHeight="560">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Padding="12"
                            Background="{StaticResource LayerPanel.Section}"
                            BorderBrush="{StaticResource LayerPanel.Border}"
                            BorderThickness="0,0,0,1">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Right"
                                        FontFamily="{StaticResource LayerPanel.MonoFont}"
                                        FontSize="10"
                                        Foreground="{StaticResource LayerPanel.Muted}"
                                        Text="CAD Tree" />
                                    <Path
                                        Width="14"
                                        Height="16"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Data="{StaticResource LayerPanel.LayersIcon}"
                                        Fill="{StaticResource LayerPanel.Cyan}"
                                        Stretch="Uniform" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource LayerPanel.Text}"
                                        Text="图层与图形" />
                                    <Border
                                        Margin="8,0,0,0"
                                        Padding="6,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource LayerPanel.Border}"
                                        CornerRadius="8">
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{StaticResource LayerPanel.Cyan}"
                                            Text="{Binding Shapes.Count, StringFormat='{}{0}'}" />
                                    </Border>
                                </DockPanel>
                                <UniformGrid Margin="0,10,0,0" Columns="3">
                                    <Button
                                        Margin="0,0,5,0"
                                        AutomationProperties.Name="新增图层"
                                        Click="NewLayer_Click"
                                        Content="新增"
                                        Style="{StaticResource LayerPanelIconButtonStyle}"
                                        Tag="{StaticResource LayerPanel.AddIcon}" />
                                    <Button
                                        Margin="0,0,5,0"
                                        AutomationProperties.Name="保存图层配置"
                                        Click="SaveLayers_Click"
                                        Content="保存"
                                        Style="{StaticResource LayerPanelIconButtonStyle}"
                                        Tag="{StaticResource Save}" />
                                    <Button
                                        AutomationProperties.Name="图层配置另存为"
                                        Click="SaveLayersAs_Click"
                                        Content="另存为"
                                        Style="{StaticResource LayerPanelIconButtonStyle}"
                                        Tag="{StaticResource LayerPanel.SaveAsIcon}" />
                                </UniformGrid>
                                <Border
                                    Margin="0,10,0,0"
                                    Padding="8,5"
                                    Background="{StaticResource LayerPanel.Background}"
                                    BorderBrush="{StaticResource LayerPanel.Border}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <DockPanel>
                                        <StackPanel
                                            Margin="8,0,0,0"
                                            DockPanel.Dock="Right"
                                            Orientation="Horizontal">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource LayerPanel.Amber}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LayerConfigurationStatus, Converter={StaticResource LayerConfigurationSaveStateConverter}, ConverterParameter=IsSaved}" Value="True">
                                                            <Setter Property="TextElement.Foreground" Value="{StaticResource LayerPanel.Green}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Path
                                                Width="10"
                                                Height="10"
                                                Margin="0,0,4,0"
                                                VerticalAlignment="Center"
                                                Data="{StaticResource LayerPanel.CheckIcon}"
                                                Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                                Stretch="Uniform" />
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                                Text="{Binding LayerConfigurationStatus, Converter={StaticResource LayerConfigurationSaveStateConverter}}" />
                                        </StackPanel>
                                        <TextBlock
                                            x:Name="LayerConfigurationFileText"
                                            FontFamily="{StaticResource LayerPanel.MonoFont}"
                                            FontSize="11"
                                            Foreground="{StaticResource LayerPanel.Muted}"
                                            Text="{Binding LayerConfigurationPath, Converter={StaticResource LayerConfigurationFileNameConverter}}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding LayerConfigurationPath}" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TreeView
                            x:Name="LayerTree"
                            Grid.Row="1"
                            MinHeight="360"
                            Margin="0"
                            Padding="8,10"
                            Background="{StaticResource LayerPanel.Background}"
                            BorderBrush="{StaticResource LayerPanel.Border}"
                            BorderThickness="0"
                            FontSize="12"
                            Foreground="#EEEEEE"
                            ItemContainerStyle="{StaticResource LayerPanelLayerItemStyle}"
                            ItemsSource="{Binding LayerGroups}"
                            PreviewKeyDown="LayerTree_PreviewKeyDown"
                            PreviewMouseLeftButtonDown="LayerTree_PreviewMouseLeftButtonDown"
                            SelectedItemChanged="LayerTree_SelectedItemChanged"
                            TextElement.FontSize="12">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemContainerStyle="{StaticResource LayerPanelShapeItemStyle}" ItemsSource="{Binding Shapes}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton
                                            AutomationProperties.HelpText="显示或隐藏此图层的所有图形"
                                            AutomationProperties.Name="{Binding Name, StringFormat='切换图层 {0} 的显示状态'}"
                                            IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                            Style="{StaticResource LayerPanelVisibilityStyle}" />
                                        <Grid
                                            Grid.Column="1"
                                            Margin="4,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse
                                                Width="8"
                                                Height="8"
                                                Margin="0,0,7,0"
                                                Fill="{Binding Color}" />
                                            <TextBlock
                                                x:Name="LayerName"
                                                Grid.Column="1"
                                                MaxWidth="120"
                                                AutomationProperties.HelpText="双击设为当前图层"
                                                Cursor="Hand"
                                                FontFamily="{StaticResource LayerPanel.MonoFont}"
                                                FontSize="12"
                                                Foreground="{StaticResource LayerPanel.Text}"
                                                MouseLeftButtonDown="LayerName_MouseLeftButtonDown"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="{Binding Name}" />
                                            <Border
                                                Grid.Column="2"
                                                Margin="5,0,0,0"
                                                Padding="4,1"
                                                Background="#422006"
                                                BorderBrush="#854D0E"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock
                                                    FontSize="9"
                                                    Foreground="{StaticResource LayerPanel.Amber}"
                                                    Text="当前活动" />
                                            </Border>
                                        </Grid>
                                        <Button
                                            Grid.Column="2"
                                            Margin="4,0,0,0"
                                            Padding="4,0"
                                            Click="EditLayer_Click"
                                            Content="编辑"
                                            FontSize="10"
                                            IsEnabled="{Binding CanEdit}"
                                            Style="{StaticResource LayerPanelRowButtonStyle}"
                                            ToolTip="编辑图层样式" />
                                        <Button
                                            Grid.Column="3"
                                            Margin="4,0,0,0"
                                            Padding="4,0"
                                            Click="SelectLayerShapes_Click"
                                            Content="选择"
                                            FontSize="10"
                                            Style="{StaticResource LayerPanelSelectButtonStyle}"
                                            ToolTip="选中此图层中可见、未锁定的图形" />
                                    </Grid>
                                    <HierarchicalDataTemplate.ItemTemplate>
                                        <DataTemplate>
                                            <Grid
                                                x:Name="ShapeRow"
                                                Margin="1"
                                                VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    x:Name="SelectionAccent"
                                                    Width="2"
                                                    Margin="-4,0,0,0"
                                                    HorizontalAlignment="Left"
                                                    Background="{StaticResource LayerPanel.Border}" />
                                                <ToggleButton
                                                    Grid.Column="0"
                                                    AutomationProperties.Name="{Binding GeometryType, StringFormat='切换 {0} 的选中状态'}"
                                                    Click="ShapeSelection_Click"
                                                    IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                    Style="{StaticResource LayerPanelShapeMarkerStyle}"
                                                    Tag="{Binding}" />
                                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        x:Name="ShapeLabel"
                                                        Margin="1,2"
                                                        VerticalAlignment="Center"
                                                        FontFamily="{StaticResource LayerPanel.MonoFont}"
                                                        FontSize="12"
                                                        Foreground="{StaticResource LayerPanel.Text}"
                                                        Text="{Binding GeometryType}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        x:Name="ShapeDetail"
                                                        Grid.Column="1"
                                                        Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        FontFamily="{StaticResource LayerPanel.MonoFont}"
                                                        FontSize="10"
                                                        Foreground="{StaticResource LayerPanel.Subtle}"
                                                        TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{StaticResource ShapeTreeDetailConverter}">
                                                                <Binding Path="GeometryType" />
                                                                <Binding Path="BoundsRect" />
                                                                <Binding Path="ShapeLayer.Measurement.PixelPerUnit" />
                                                                <Binding Path="ShapeLayer.Measurement.UnitName" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </Grid>
                                                <Grid Grid.Column="2" Margin="6,0,2,0">
                                                    <Path
                                                        x:Name="ShapeVisibilityStatus"
                                                        Width="12"
                                                        Height="12"
                                                        VerticalAlignment="Center"
                                                        Data="{StaticResource SolidShow}"
                                                        Fill="{StaticResource LayerPanel.Muted}"
                                                        Stretch="Uniform">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="ToolTip" Value="图形可见" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DataContext.IsVisible, RelativeSource={RelativeSource AncestorType=TreeViewItem, AncestorLevel=2}}" Value="False">
                                                                        <Setter Property="Opacity" Value="0.35" />
                                                                        <Setter Property="ToolTip" Value="所属图层已隐藏" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsGeometryRendered}" Value="False">
                                                                        <Setter Property="Opacity" Value="0.35" />
                                                                        <Setter Property="ToolTip" Value="图形尚未完成" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                    <StackPanel
                                                        x:Name="ShapeLockStatus"
                                                        Orientation="Horizontal"
                                                        Visibility="Collapsed">
                                                        <Ellipse
                                                            x:Name="ShapeReadyStatus"
                                                            Width="6"
                                                            Height="6"
                                                            Margin="0,0,5,0"
                                                            Fill="{StaticResource LayerPanel.Green}" />
                                                        <Path
                                                            x:Name="ShapeLockIcon"
                                                            Width="12"
                                                            Height="12"
                                                            VerticalAlignment="Center"
                                                            Data="{StaticResource LayerPanel.UnlockedIcon}"
                                                            Fill="{StaticResource LayerPanel.Amber}"
                                                            Stretch="Uniform"
                                                            ToolTip="未锁定，可编辑" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="ShapeLabel" Property="Foreground" Value="{StaticResource LayerPanel.Amber}" />
                                                    <Setter TargetName="ShapeLabel" Property="FontWeight" Value="SemiBold" />
                                                    <Setter TargetName="ShapeDetail" Property="Foreground" Value="{StaticResource LayerPanel.Amber}" />
                                                    <Setter TargetName="SelectionAccent" Property="Background" Value="{StaticResource LayerPanel.Amber}" />
                                                    <Setter TargetName="ShapeVisibilityStatus" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="ShapeLockStatus" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                    <Setter TargetName="ShapeVisibilityStatus" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="ShapeLockStatus" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="ShapeReadyStatus" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="ShapeLockIcon" Property="Data" Value="{StaticResource LayerPanel.LockedIcon}" />
                                                    <Setter TargetName="ShapeLockIcon" Property="ToolTip" Value="已锁定，双击画布中的图形可解锁" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </HierarchicalDataTemplate.ItemTemplate>
                                    <HierarchicalDataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter TargetName="LayerName" Property="FontWeight" Value="SemiBold" />
                                            <Setter TargetName="LayerName" Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </HierarchicalDataTemplate.Triggers>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>

                        <Separator
                            Grid.Row="2"
                            Height="1"
                            Margin="0"
                            Background="{StaticResource LayerPanel.Border}" />

                        <DockPanel Grid.Row="3">
                            <Border
                                Margin="0,0,0,10"
                                Padding="12"
                                Background="{StaticResource LayerPanel.Section}"
                                BorderBrush="{StaticResource LayerPanel.Border}"
                                BorderThickness="0,0,0,1"
                                DockPanel.Dock="Top"
                                TextElement.FontFamily="{StaticResource LayerPanel.TextFont}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="12" Foreground="{StaticResource LayerPanel.Muted}">
                                            <Run Text="已选 " /><Run Foreground="{StaticResource LayerPanel.Amber}" Text="{Binding SelectedShapeCount, Mode=OneWay}" /><Run Text=" 个图形" />
                                        </TextBlock>
                                        <TextBlock
                                            x:Name="SelectedShapeSummaryText"
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            HorizontalAlignment="Right"
                                            FontFamily="{StaticResource LayerPanel.MonoFont}"
                                            FontSize="10"
                                            Foreground="{StaticResource LayerPanel.Green}"
                                            TextTrimming="CharacterEllipsis">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource ShapeSelectionSummaryConverter}">
                                                    <Binding Path="SelectedShapeCount" />
                                                    <Binding Path="SelectedShape.GeometryType" />
                                                    <Binding Path="SelectedLayerSummary" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{StaticResource LayerPanel.Muted}"
                                        Text="所属图层归属" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox
                                            x:Name="AssignedLayerSelector"
                                            Margin="0,0,6,0"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="所选图形所属图层"
                                            Background="{StaticResource LayerPanel.Background}"
                                            BorderBrush="{StaticResource LayerPanel.Border}"
                                            FontFamily="{StaticResource LayerPanel.MonoFont}"
                                            ItemsSource="{Binding Layers}"
                                            SelectedItem="{Binding TargetShapeLayer, Mode=TwoWay}"
                                            Style="{StaticResource DarkComboBoxStyle}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Foreground="{StaticResource DarkPanel.ValueForeground}" Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button
                                            x:Name="AssignLayerButton"
                                            Grid.Column="1"
                                            Click="AssignLayer_Click"
                                            Content="应用到所选图形"
                                            IsEnabled="{Binding CanAssignSelectedLayer}"
                                            Style="{StaticResource LayerPanelButtonStyle}" />
                                    </Grid>
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        FontSize="10"
                                        Foreground="{StaticResource LayerPanel.Subtle}"
                                        Text="移入隐藏图层后，图形将在检测画布中自动隐藏。"
                                        TextWrapping="Wrap" />
                                    <Separator
                                        Height="1"
                                        Margin="0,9,0,8"
                                        Background="{StaticResource LayerPanel.Border}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{StaticResource LayerPanel.Muted}"
                                            Text="图元编组操作" />
                                        <TextBlock
                                            x:Name="SelectedGroupSummaryText"
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            HorizontalAlignment="Right"
                                            FontSize="10"
                                            Foreground="{StaticResource LayerPanel.Subtle}"
                                            Text="{Binding SelectedGroupSummary}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding SelectedGroupSummary}" />
                                    </Grid>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            x:Name="GroupShapesButton"
                                            Margin="0,0,3,0"
                                            AutomationProperties.Name="组合所选图形"
                                            Command="{Binding GroupShapesCommand}"
                                            Content="组合"
                                            Style="{StaticResource LayerPanelIconButtonStyle}"
                                            Tag="{StaticResource LayerPanel.GroupIcon}"
                                            ToolTip="将所选图形组合在一起（Ctrl+G）" />
                                        <Button
                                            x:Name="UngroupShapesButton"
                                            Grid.Column="1"
                                            Margin="3,0,0,0"
                                            AutomationProperties.Name="取消所选图形的组合"
                                            Command="{Binding UngroupShapesCommand}"
                                            Content="取消组合"
                                            Style="{StaticResource LayerPanelIconButtonStyle}"
                                            Tag="{StaticResource LayerPanel.UngroupIcon}"
                                            ToolTip="取消所选图形的组合（Ctrl+Shift+G）" />
                                    </Grid>
                                    <TextBlock
                                        Margin="0,5,0,0"
                                        FontSize="10"
                                        Foreground="{StaticResource LayerPanel.Subtle}"
                                        Text="{Binding GroupingPrompt}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <TextBlock
                                Margin="12,0,12,6"
                                DockPanel.Dock="Top"
                                FontFamily="{StaticResource LayerPanel.TextFont}"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource LayerPanel.Text}"
                                Text="属性" />

                            <ScrollViewer
                                MaxHeight="320"
                                Margin="8,0,8,8"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <ContentControl Content="{Binding PropertyShape}">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Style.Triggers>
                                                <Trigger Property="Content" Value="{x:Null}">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate>
                                                                <Border
                                                                    Padding="12"
                                                                    Background="{StaticResource LayerPanel.Section}"
                                                                    BorderBrush="{StaticResource LayerPanel.Border}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4">
                                                                    <TextBlock
                                                                        VerticalAlignment="Center"
                                                                        FontSize="12"
                                                                        Foreground="{StaticResource LayerPanel.Muted}"
                                                                        LineHeight="18"
                                                                        Text="{Binding SelectionPrompt}"
                                                                        TextAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </ScrollViewer>
                        </DockPanel>

                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>



    </Grid>


</UserControl>
