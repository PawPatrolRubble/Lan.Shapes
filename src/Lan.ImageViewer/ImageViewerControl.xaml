<UserControl
    x:Class="Lan.ImageViewer.ImageViewerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Lan.ImageViewer"
    xmlns:shapeEnums="clr-namespace:Lan.Shapes.Enums;assembly=Lan.Shapes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shapes="clr-namespace:Lan.Shapes.Shapes;assembly=Lan.Shapes"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    x:Name="Root"
    d:DataContext="{d:DesignInstance local:IImageViewerViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="White"
    mc:Ignorable="d">


    <UserControl.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Lan.ImageViewer;component/Style.xaml" />
                <ResourceDictionary Source="/Lan.ImageViewer;component/Geometries.xaml" />


            </ResourceDictionary.MergedDictionaries>

            <!--<xamlFlair:Offset x:Key="PositiveOffset" OffsetValue="20" />
            <xamlFlair:Offset x:Key="NegativeOffset" OffsetValue="-50" />

            <system:Double x:Key="SmallScaleFactor">0.75</system:Double>

            <xamlFlair:AnimationSettings
                x:Key="SlideFromTop"
                Kind="TranslateYFrom"
                OffsetY="{StaticResource NegativeOffset}" />-->

            <!--  Scale to a smaller value  -->

            <SolidColorBrush x:Key="Expander.Static.Arrow.Stroke" Color="White" />
            <SolidColorBrush x:Key="Expander.MouseOver.Arrow.Stroke" Color="Lime" />
            <SolidColorBrush x:Key="Expander.Pressed.Arrow.Stroke" Color="Lime" />
            <SolidColorBrush x:Key="Expander.Disabled.Arrow.Stroke" Color="#FF707070" />


        </ResourceDictionary>

    </UserControl.Resources>


    <Grid>


        <local:ImageViewer
            x:Name="ImageViewer"
            BorderBrush="LightGray"
            BorderThickness="0"
            CrossLineColor="Lime"
            DefaultStrokeThickness="1"
            ImageSource="{Binding Image, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
            LineDirectionMode="{Binding LineDirectionMode, ElementName=Root}"
            MouseDoubleClickPosition="{Binding MouseDoubleClickPosition, UpdateSourceTrigger=PropertyChanged, Mode=OneWayToSource}"
            Scale="{Binding Scale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            ShowCrossLine="{Binding ShowCrossLine}"
            ShowGeometries="{Binding ShowGeometries, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=True, TargetNullValue=True}"
            SketchBoardDataManager="{Binding SketchBoardDataManager}"
            StrokeThickness="1"
            Style="{StaticResource ImageViewer.Compact}" />



        <!-- Top-Right Floating Controls (Toolbar + Property Panel) -->
        <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Floating Top Toolbar -->
            <Border
                Grid.Row="0"
                HorizontalAlignment="Right"
                Background="#E61E1E22"
                BorderBrush="{StaticResource DarkPanel.Border}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="4,2"
                SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Opacity="0.35" ShadowDepth="2" Direction="270" Color="Black" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Geometry Drawing Tools -->
                    <ItemsControl
                        x:Name="Tools"
                        VerticalAlignment="Center"
                        FontSize="15"
                        ItemTemplate="{StaticResource GeometryTypeTemplate}"
                        ItemsSource="{Binding GeometryTypeList}"
                        Visibility="{Binding ShowShapeTypes, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <StackPanel
                        Orientation="Horizontal"
                        Margin="6,0,2,0"
                        Visibility="{Binding ShowShapeTypes, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            Text="Line:"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource DarkPanel.LabelForeground}" />
                        <ComboBox
                            x:Name="LineDirectionSelector"
                            Width="108"
                            VerticalAlignment="Center"
                            SelectedValuePath="Tag"
                            SelectedValue="{Binding LineDirectionMode, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="Line direction"
                            ToolTip="Line direction. In Free mode, hold Shift while drawing or resizing to choose horizontal or vertical.">
                            <ComboBoxItem Content="Free" Tag="{x:Static shapeEnums:LineDirectionMode.Free}" />
                            <ComboBoxItem Content="Horizontal" Tag="{x:Static shapeEnums:LineDirectionMode.Horizontal}" />
                            <ComboBoxItem Content="Vertical" Tag="{x:Static shapeEnums:LineDirectionMode.Vertical}" />
                        </ComboBox>
                    </StackPanel>

                    <!-- Divider between tools and action buttons -->
                    <Rectangle
                        Width="1"
                        Height="20"
                        Margin="4,0"
                        Fill="{StaticResource DarkPanel.Border}"
                        Visibility="{Binding ShowShapeTypes, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <!-- Eye Icon ToggleButton (Show / Hide all geometries) -->
                    <ToggleButton
                        x:Name="BtnToggleGeometries"
                        Style="{StaticResource DarkIconButtonToggleStyle}"
                        Margin="2,0"
                        IsChecked="{Binding ShowGeometries, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=True, TargetNullValue=True}"
                        Click="BtnToggleGeometries_Click"
                        ToolTip="显示/隐藏图形">
                        <Path
                            x:Name="EyeIconPath"
                            Width="16"
                            Height="16"
                            Stretch="Uniform"
                            Fill="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Foreground}">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="{StaticResource EyeOff}" />
                                    <Setter Property="Opacity" Value="0.6" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=IsChecked}" Value="True">
                                            <Setter Property="Data" Value="{StaticResource Eye}" />
                                            <Setter Property="Opacity" Value="1.0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </ToggleButton>

                    <!-- Gear Icon ToggleButton (Show / Hide Properties Panel) -->
                    <ToggleButton
                        x:Name="BtnToggleProperties"
                        Style="{StaticResource DarkIconButtonToggleStyle}"
                        Margin="2,0"
                        IsChecked="{Binding ShowSimpleCanvas, Mode=TwoWay}"
                        ToolTip="显示/隐藏属性面板">
                        <Path
                            Width="16"
                            Height="16"
                            Stretch="Uniform"
                            Data="{StaticResource Gear}"
                            Fill="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Foreground}" />
                    </ToggleButton>
                </StackPanel>
            </Border>

            <!-- Floating Property Panel (Positioned under the toolbar) -->
            <Border
                Grid.Row="1"
                Margin="0,6,0,0"
                HorizontalAlignment="Right"
                Width="260"
                Background="{StaticResource DarkPanel.Background}"
                BorderBrush="{StaticResource DarkPanel.Border}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="8"
                SnapsToDevicePixels="True"
                Visibility="{Binding ShowSimpleCanvas, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" Opacity="0.45" ShadowDepth="3" Direction="270" Color="Black" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="2,2,2,6">
                        <TextBlock
                            Text="图形列表"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource DarkPanel.HeaderForeground}"
                            VerticalAlignment="Center" />
                        <Border
                            HorizontalAlignment="Right"
                            Background="#333338"
                            CornerRadius="8"
                            Padding="6,1"
                            VerticalAlignment="Center">
                            <TextBlock
                                Text="{Binding Shapes.Count, StringFormat='{}{0}'}"
                                FontSize="11"
                                Foreground="#AAAAAA" />
                        </Border>
                    </DockPanel>

                    <ListBox
                        x:Name="ListBox"
                        Grid.Row="1"
                        MinHeight="100"
                        MaxHeight="160"
                        Margin="0,0,0,6"
                        Style="{StaticResource DarkListBoxStyle}"
                        ItemsSource="{Binding Shapes}"
                        SelectedItem="{Binding SelectedShape, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding GeometryType}" Margin="4,2" VerticalAlignment="Center" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.InputBindings>
                            <KeyBinding Key="Delete" Command="{Binding DeleteShapeCommand}" />
                        </ListBox.InputBindings>
                    </ListBox>

                    <Separator Grid.Row="2" Background="{StaticResource DarkPanel.Border}" Margin="0,2,0,6" Height="1" />

                    <DockPanel Grid.Row="3">
                        <TextBlock
                            DockPanel.Dock="Top"
                            Text="属性"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource DarkPanel.HeaderForeground}"
                            Margin="2,0,2,6" />

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="320">
                            <ContentControl Content="{Binding Path=SelectedItem, ElementName=ListBox}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Style.Triggers>
                                            <Trigger Property="Content" Value="{x:Null}">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate>
                                                            <Border Background="#1A1A1C" CornerRadius="4" Padding="12" BorderBrush="#2D2D32" BorderThickness="1">
                                                                <TextBlock
                                                                    Text="未选择图形&#x0a;请在列表或画布中选择图形"
                                                                    TextAlignment="Center"
                                                                    Foreground="#777780"
                                                                    FontSize="12"
                                                                    LineHeight="18"
                                                                    VerticalAlignment="Center" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </ScrollViewer>
                    </DockPanel>

                </Grid>
            </Border>
        </Grid>



    </Grid>


</UserControl>
